    @Before
    public void setUp() throws MalformedURLException {
        URL serverUrl = getUrl();
        ensureAppiumServer(serverUrl);
        try {
            driver = new AndroidDriver(serverUrl, options);
        } catch (WebDriverException exception) {
            if (isConnectionRefused(exception)) {
                throw new IllegalStateException(
                        "Cannot connect to the Appium server at " + serverUrl
                                + ". Start Appium with `appium --address 127.0.0.1 --port 4723`, "
                                + "confirm an Android device is available with `adb devices`, "
                                + "or configure APPIUM_SERVER_URL / -Dappium.server.url.",
                        exception);
            }
            throw exception;
        }
        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
    }

    @After
    public void tearDown() {
        if (driver != null) {
            driver.quit();
            driver = null;
        }
    }

    @AfterClass
    public static void stopStartedAppiumServer() {
        if (appiumProcess != null && appiumProcess.isAlive()) {
            appiumProcess.destroy();
            try {
                if (!appiumProcess.waitFor(5, java.util.concurrent.TimeUnit.SECONDS)) {
                    appiumProcess.destroyForcibly();
                }
            } catch (InterruptedException exception) {
                appiumProcess.destroyForcibly();
                Thread.currentThread().interrupt();
            }
        }
        appiumProcess = null;
    }

    private void ensureAppiumServer(URL serverUrl) {
        if (isServerReady(serverUrl)) {
            return;
        }

        URI uri = URI.create(serverUrl.toString());
        if (!"http".equalsIgnoreCase(uri.getScheme()) || !isLoopback(uri.getHost())) {
            throw new IllegalStateException("Appium server is not reachable at " + serverUrl
                    + ". Automatic startup is supported only for a local HTTP server.");
        }

        String command = System.getProperty("appium.command");
        if (command == null || command.isBlank()) {
            command = System.getenv("APPIUM_COMMAND");
        }
        if (command == null || command.isBlank()) {
            command = "appium";
        }

        try {
            ProcessBuilder processBuilder = new ProcessBuilder(command, "--address", uri.getHost(),
                    "--port", Integer.toString(uri.getPort() < 0 ? 4723 : uri.getPort()));
            String basePath = uri.getPath();
            if (basePath != null && !basePath.isBlank() && !"/".equals(basePath)) {
                processBuilder.command().add("--base-path");
                processBuilder.command().add(basePath);
            }
            appiumProcess = processBuilder.inheritIO().start();
        } catch (IOException exception) {
            throw new IllegalStateException("Could not start Appium automatically. Install Appium and make the `appium` "
                    + "command available, or set APPIUM_COMMAND / -Dappium.command to its executable path.", exception);
        }

        long deadline = System.nanoTime() + APPIUM_STARTUP_TIMEOUT.toNanos();
        while (System.nanoTime() < deadline) {
            if (isServerReady(serverUrl)) {
                return;
            }
            if (!appiumProcess.isAlive()) {
                throw new IllegalStateException("Appium exited before becoming ready. Check the Appium output above.");
            }
            try {
                Thread.sleep(250);
            } catch (InterruptedException exception) {
                Thread.currentThread().interrupt();
                throw new IllegalStateException("Interrupted while waiting for the Appium server to start.", exception);
            }
        }
        throw new IllegalStateException("Appium did not become ready at " + serverUrl + " within "
                + APPIUM_STARTUP_TIMEOUT.toSeconds() + " seconds. Check the Appium output above.");
    }

    private boolean isServerReady(URL serverUrl) {
        URI uri = URI.create(serverUrl.toString());
        String path = uri.getPath();
        String statusPath = (path == null || path.isBlank() || "/".equals(path)
                ? "" : path.replaceAll("/+$", "")) + "/status";
        URI statusUri = URI.create(uri.getScheme() + "://" + uri.getRawAuthority() + statusPath);
        try {
            HttpClient client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(1)).build();
            HttpRequest request = HttpRequest.newBuilder(statusUri)
                    .timeout(Duration.ofSeconds(1))
                    .GET()
                    .build();
            HttpResponse<Void> response = client.send(request, HttpResponse.BodyHandlers.discarding());
            return response.statusCode() >= 200 && response.statusCode() < 300;
        } catch (IOException exception) {
            return false;
        } catch (InterruptedException exception) {
            Thread.currentThread().interrupt();
            throw new IllegalStateException("Interrupted while checking the Appium server.", exception);
        }
    }

    private boolean isLoopback(String host) {
        try {
            return InetAddress.getByName(host).isLoopbackAddress();
        } catch (IOException exception) {
            return false;
        }
    }

    private URL getUrl() throws MalformedURLException {
        String configuredUrl = System.getProperty("appium.server.url");
        if (configuredUrl == null || configuredUrl.isBlank()) {
            configuredUrl = System.getenv("APPIUM_SERVER_URL");
        }
        String serverUrl = configuredUrl == null || configuredUrl.isBlank()
                ? "http://127.0.0.1:4723"
                : configuredUrl.trim();
        URI uri = URI.create(serverUrl);
        if (!"http".equalsIgnoreCase(uri.getScheme())
                && !"https".equalsIgnoreCase(uri.getScheme())) {
            throw new IllegalArgumentException("Appium server URL must use HTTP or HTTPS: " + serverUrl);
        }
        if (uri.getHost() == null) {
            throw new IllegalArgumentException("Appium server URL must include a host: " + serverUrl);
        }
        return uri.toURL();
    }

    private boolean isConnectionRefused(Throwable exception) {
        for (Throwable cause = exception; cause != null; cause = cause.getCause()) {
            if (cause instanceof ConnectException) {
                return true;
            }
        }
        return false;
    }

    public static String getOTPFromDatabase(String mobileNumber)
            throws SQLException {

        String url = "jdbc:mysql://172.29.0.11:3306/communication";
        String username = "";
        String password = "";



        String query =
                "SELECT otp " +
                        "FROM otp_info " +
                        "WHERE mobile_number = ? " +
                        "ORDER BY id DESC " +
                        "LIMIT 1";


        try (Connection connection = DriverManager.getConnection(url, username, password);

             PreparedStatement statement =
                     connection.prepareStatement(query)) {

            statement.setString(1, mobileNumber);

            try (ResultSet result = statement.executeQuery()) {

                if (result.next()) {

                    String message = result.getString("otp");

                    Pattern pattern = Pattern.compile(
                            "(?:verification code is\\s*<b>|OTP is\\s*)(\\d{6})"
                    );


                    Matcher matcher = pattern.matcher(message);

                    if (matcher.find()) {
                        return matcher.group(1);
                    }

                    return result.getString("otp");
                }
            }
        }
        return null;
    }
